generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OccupancyStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_ORDER
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum StaffRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
}

model Room {
  id                 String             @id @default(cuid())
  number             String             @unique
  floor              Int                @default(1)
  category           String
  rate               Decimal            @db.Decimal(10, 2)
  occupancyStatus    OccupancyStatus    @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  notes              String?
  reservations       Reservation[]
  tasks              HousekeepingTask[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Guest {
  id           String        @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  idType       String?
  idNumber     String?
  reservations Reservation[]
  payments     Payment[]
  createdAt    DateTime      @default(now())
}

model Reservation {
  id          String            @id @default(cuid())
  bookingCode String            @unique
  guestId     String
  roomId      String
  checkIn     DateTime
  checkOut    DateTime?
  checkedInAt DateTime?
  checkedOutAt DateTime?
  adults      Int               @default(1)
  children    Int               @default(0)
  status      ReservationStatus @default(PENDING)
  totalAmount Decimal?          @db.Decimal(10, 2)
  source      String            @default("WALK_IN")
  notes       String?
  guest       Guest             @relation(fields: [guestId], references: [id])
  room        Room              @relation(fields: [roomId], references: [id])
  payments    Payment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([checkIn, status])
  @@index([roomId, checkIn, checkOut])
}

model HousekeepingTask {
  id          String     @id @default(cuid())
  roomId      String
  taskType    String     @default("DAILY_CLEANING")
  description String
  assignedTo  String?
  status      TaskStatus @default(PENDING)
  scheduledAt DateTime   @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  room        Room       @relation(fields: [roomId], references: [id])
  createdAt   DateTime   @default(now())
  @@index([scheduledAt, status])
}

model Payment {
  id            String        @id @default(cuid())
  paymentCode   String        @unique
  guestId       String
  reservationId String?
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        String        @default("PAID")
  reference     String?
  paidAt        DateTime      @default(now())
  guest         Guest         @relation(fields: [guestId], references: [id])
  reservation  Reservation?  @relation(fields: [reservationId], references: [id])
}

model Staff {
  id        String   @id @default(cuid())
  fullName  String
  role      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())
  fullName String
  email String @unique
  passwordHash String
  role StaffRole @default(RECEPTIONIST)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
