generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OccupancyStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_ORDER
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  branches      Branch[]
  users         User[]
  guestAccounts GuestAccount[]
  guests        Guest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Branch {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  phone          String?
  email          String?
  active         Boolean       @default(true)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rooms          Room[]
  reservations   Reservation[]
  payments       Payment[]
  staff          StaffBranch[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model StaffBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions Json     @default("[]")
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isSystem, name])
}

model Room {
  id                 String             @id @default(cuid())
  number             String
  floor              Int                @default(1)
  category           String
  rate               Decimal            @db.Decimal(10, 2)
  occupancyStatus    OccupancyStatus    @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  notes              String?
  archivedAt         DateTime?
  branchId           String?
  branch             Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservations       Reservation[]
  tasks              HousekeepingTask[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([branchId, number])
  @@index([branchId, archivedAt])
}

model GuestAccount {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  guestRecords Guest[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Guest {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fullName       String
  phone          String
  email          String?
  idType         String?
  idNumber       String?
  guestAccountId String?
  guestAccount   GuestAccount? @relation(fields: [guestAccountId], references: [id])
  reservations   Reservation[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  @@index([guestAccountId])
}

model Reservation {
  id           String                     @id @default(cuid())
  bookingCode  String                     @unique
  guestId      String
  roomId       String
  branchId     String?
  checkIn      DateTime
  checkOut     DateTime?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  adults       Int                        @default(1)
  children     Int                        @default(0)
  status       ReservationStatus          @default(PENDING)
  totalAmount  Decimal?                   @db.Decimal(10, 2)
  extraCharges Decimal                    @default(0) @db.Decimal(10, 2)
  discount     Decimal                    @default(0) @db.Decimal(10, 2)
  source       String                     @default("WALK_IN")
  notes        String?
  guest        Guest                      @relation(fields: [guestId], references: [id])
  room         Room                       @relation(fields: [roomId], references: [id])
  branch       Branch?                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payments     Payment[]
  statusHistory ReservationStatusHistory[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([checkIn, status])
  @@index([roomId, checkIn, checkOut])
  @@index([branchId, checkIn, status])
}

model HousekeepingTask {
  id          String     @id @default(cuid())
  roomId      String
  taskType    String     @default("DAILY_CLEANING")
  description String
  assignedTo  String?
  status      TaskStatus @default(PENDING)
  scheduledAt DateTime   @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  room        Room       @relation(fields: [roomId], references: [id])
  createdAt   DateTime   @default(now())

  @@index([scheduledAt, status])
}

model Payment {
  id            String        @id @default(cuid())
  paymentCode   String        @unique
  guestId       String
  reservationId String?
  branchId      String?
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        String        @default("PAID")
  reference     String?
  paidAt        DateTime      @default(now())
  guest         Guest         @relation(fields: [guestId], references: [id])
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, paidAt])
}

model Staff {
  id        String   @id @default(cuid())
  fullName  String
  role      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("RECEPTIONIST")
  roleId       String?
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchAssignments StaffBranch[]
  roleRecord   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
}

model ReservationStatusHistory {
  id            String      @id @default(cuid())
  reservationId String
  fromStatus    String?
  toStatus      String
  changedBy     String
  changedAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, changedAt])
}
